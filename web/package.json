{
  "name": "epzero-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Epzero website: a from-scratch HNSW vector database running in the browser (Svelte 5, three.js, WebAssembly).",
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && npm run check && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/three": "^0.186.0",
    "marked": "^16.4.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "three": "^0.186.1",
    "umap-js": "^1.4.0"
  }
}
