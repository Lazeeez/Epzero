// epzero.dev on Cloudflare Workers: the built site as static assets, plus a Worker for the CLIP
// models in R2 (see worker/index.js). Deployed by .github/workflows/site.yml.
{
  "name": "epzero",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "epzero.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /try serves try/index.html; /try/ redirects to /try.
    "html_handling": "drop-trailing-slash",
    // Unknown paths get 404.html (the app's not-found page) with a 404 status.
    "not_found_handling": "404-page",
    // Only the models need the Worker; everything else is served without running it.
    "run_worker_first": ["/models/*"]
  },
  "r2_buckets": [{ "binding": "MODELS", "bucket_name": "epzero-assets" }],
  "observability": { "enabled": true }
}
