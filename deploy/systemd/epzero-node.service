[Unit]
Description=Epzero data node
After=network-online.target
Wants=network-online.target

[Service]
User=epzero
Group=epzero
EnvironmentFile=/etc/epzero/node.env
ExecStart=/opt/epzero/bin/epzero-node --listen 0.0.0.0:7000 --advertise ${EPZERO_ADVERTISE} --name ${EPZERO_NAME} \
    --data /var/lib/epzero/data --dim 512 --metric cosine --max 60000 --token-file /etc/epzero/token --sync always
# A crash (including the chaos endpoint) is recovered from the write-ahead log on restart.
Restart=always
RestartSec=8
LimitNOFILE=65536
# Hardening: the node only needs its data directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/epzero
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
